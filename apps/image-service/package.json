{
  "name": "@matrummet/image-service",
  "version": "0.0.1",
  "description": "Image upload, processing and serving service for Matrummet",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@matrummet/shared": "workspace:*",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@matrummet/eslint": "workspace:*",
    "@matrummet/tsconfig": "workspace:*",
    "@types/bun": "^1.4.2",
    "bun-types": "^1.4.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.13.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "jsonwebtoken": "^9.0.3",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
